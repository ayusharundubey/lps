# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Required if Gemini AI API calls are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE POSTGRESQL CONFIGURATION (Server & Public Client)
# Never expose SUPABASE_SERVICE_ROLE_KEY or DATABASE_URL to browser bundles.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# RAZORPAY PAYMENT GATEWAY CONFIGURATION (Server-side only)
# Default to test mode until merchant KYC, live credentials, and webhooks are verified.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_MODE=test

# INITIAL OWNER ADMIN CONFIGURATION
# Optional: if ADMIN_BOOTSTRAP_PASSWORD is unset, use the one-time /admin/login claim flow.
OWNER_ADMIN_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
